# Configuración de AWS Cognito
# Copia este archivo a .env y completa con tus valores

# Credenciales de AWS (requeridas para acceder a Cognito)
# Obtén estas credenciales desde: https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=tu_access_key_aqui
AWS_SECRET_ACCESS_KEY=tu_secret_key_aqui
AWS_DEFAULT_REGION=us-east-1

# Configuración de Cognito User Pool
# User Pool ID ya está configurado en app.py: us-east-1_o7y7iPcVz
# Si el Client ID no se detecta automáticamente, configúralo aquí:
COGNITO_CLIENT_ID=tu_client_id_aqui

# Client Secret (requerido si el App Client tiene un secret habilitado)
# Obtén este valor desde: AWS Cognito Console → Tu User Pool → App integration → App clients → [Tu App] → Show details
COGNITO_CLIENT_SECRET=tu_client_secret_aqui

# Secret Key para sesiones de Flask (cambia en producción)
SECRET_KEY=dev-secret-key-change-in-production
